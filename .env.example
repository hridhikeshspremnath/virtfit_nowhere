# Copy to .env.local and restart `npm run dev`.

# Replicate hosts the try-on and animation models (paid, per run). https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Optional: swap the models. Check each model's licence before commercial use.
# TRYON_MODEL=cuuupid/idm-vton
# ANIMATE_MODEL=zsxkib/mimic-motion

# Assets the pipeline needs:
#   public/garments/<look-id>-top.png   flat product photo of each look's top, e.g. streetwear-top.png
#   public/motions/<turn|walk|arms|sit>.mp4   one driving clip per motion

# Stock placeholders for the ring and product shots: add ONE key, then run `npm run images`.
# PEXELS_API_KEY=        free, instant: https://www.pexels.com/api/
# UNSPLASH_ACCESS_KEY=   free: https://unsplash.com/developers
